# DJANGO_SETTINGS_MODULE is auto-selected by manage.py (test → .test, else → .development)
# and by wsgi/asgi (→ .production). Override only if you know why.
# DJANGO_SETTINGS_MODULE=jobApp.settings.development

#postgredb

DB_NAME=your_database_name
DB_USER=your_username
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432

SECRET_KEY = 'your_secret_key'

# Deployment
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
ADMIN_URL=admin/

# CORS (comma-separated list; empty + DEBUG=true enables CORS_ALLOW_ALL_ORIGINS)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Production security headers (leave defaults for local dev)
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# SECURE_HSTS_PRELOAD=true
# SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO=https
# CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com